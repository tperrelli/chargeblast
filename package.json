{
  "name": "tiago-chargeblast",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "tsc -p tests/tsconfig.json && node --test .test-build/tests/*.test.js && node --import ./tests/setup-dom.mjs --import tsx --test tests/*.test.tsx",
    "format": "prettier --write \"app/**/*.{ts,tsx,css}\" \"components/**/*.{ts,tsx}\" \"features/**/*.{ts,tsx,css}\" \"lib/**/*.ts\" \"tests/**/*.{ts,tsx,json,mjs}\" \"*.{json,mjs,ts}\"",
    "format:check": "prettier --check \"app/**/*.{ts,tsx,css}\" \"components/**/*.{ts,tsx}\" \"features/**/*.{ts,tsx,css}\" \"lib/**/*.ts\" \"tests/**/*.{ts,tsx,json,mjs}\" \"*.{json,mjs,ts}\""
  },
  "dependencies": {
    "next": "16.4.6",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "4.3.3",
    "@testing-library/dom": "10.4.1",
    "@testing-library/react": "16.3.0",
    "@types/jsdom": "21.1.7",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "jsdom": "26.1.0",
    "prettier": "3.8.4",
    "tailwindcss": "4.3.3",
    "tsx": "4.20.3",
    "typescript": "^5"
  }
}
